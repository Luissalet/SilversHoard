diff --git a/src/genx/items.rs b/src/genx/items.rs
index 7600f99..83cb637 100644
--- a/src/genx/items.rs
+++ b/src/genx/items.rs
@@ -867,6 +867,50 @@ pub fn item_on_switch_in(
     }
 }
 
+// Leftovers and Black Sludge act at residual order 5 in the simulator, before Leech Seed (8),
+// poison (9) and burn (10): a full Pokemon with Leftovers that is burned ends the turn at -1/16.
+// Black Sludge damages a holder that is not Poison type by 1/8 of its maximum HP.
+pub fn item_end_of_turn_residual_heal(
+    state: &mut State,
+    side_ref: &SideReference,
+    instructions: &mut StateInstructions,
+) {
+    let heal_blocked = state
+        .get_side_immutable(side_ref)
+        .volatile_statuses
+        .contains(&super::state::PokemonVolatileStatus::HEALBLOCK);
+    let active_pkmn = state.get_side(side_ref).get_active();
+    let heals = match active_pkmn.item {
+        Items::LEFTOVERS => true,
+        Items::BLACKSLUDGE => active_pkmn.has_type(&PokemonType::POISON),
+        _ => return,
+    };
+    if heals {
+        // Heal Block (Psychic Noise) stops Leftovers and Black Sludge too
+        if active_pkmn.hp < active_pkmn.maxhp && !heal_blocked {
+            let heal_amount = cmp::min(active_pkmn.maxhp / 16, active_pkmn.maxhp - active_pkmn.hp);
+            active_pkmn.hp += heal_amount;
+            instructions
+                .instruction_list
+                .push(Instruction::Heal(HealInstruction {
+                    side_ref: side_ref.clone(),
+                    heal_amount,
+                }));
+        }
+    } else if active_pkmn.ability != Abilities::MAGICGUARD {
+        let damage_amount = cmp::min(cmp::max(active_pkmn.maxhp / 8, 1), active_pkmn.hp);
+        if damage_amount > 0 {
+            active_pkmn.hp -= damage_amount;
+            instructions
+                .instruction_list
+                .push(Instruction::Damage(DamageInstruction {
+                    side_ref: side_ref.clone(),
+                    damage_amount,
+                }));
+        }
+    }
+}
